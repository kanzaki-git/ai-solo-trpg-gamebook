<div class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(109,40,217,0.18),transparent_45%)]"></div>

  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <header class="mb-8 text-center">
      <p class="text-sm text-slate-400">
        <%= @play_session.gamebook.title %>
      </p>

      <p class="mt-5 text-xs font-bold tracking-[0.3em] text-violet-300/80 uppercase">
        物語の結末
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-wide text-[#f3eee4] sm:text-4xl">
        <%= @ending_scene.title %>
      </h1>

      <div class="mx-auto mt-6 h-px max-w-xs bg-gradient-to-r from-transparent via-violet-400/60 to-transparent"></div>
    </header>

    <section class="rounded-2xl border border-violet-400/30 bg-gradient-to-b from-slate-800/90 to-slate-950/90 px-5 py-7 shadow-2xl shadow-black/40 sm:px-8 sm:py-10">
      <div class="mb-7 text-center">
        <% ending_type_name, ending_type_class =
             case @ending_scene.ending_type
             when "bad"
               [ "バッドエンディング", "border-red-400/30 bg-red-950/40 text-red-200" ]
             when "normal"
               [ "ノーマルエンディング", "border-sky-400/30 bg-sky-950/40 text-sky-200" ]
             when "true"
               [ "トゥルーエンディング", "border-amber-300/40 bg-amber-950/30 text-amber-200" ]
             else
               [ "エンディング", "border-violet-400/30 bg-violet-950/40 text-violet-200" ]
             end %>

        <span class="inline-flex rounded-full border px-4 py-2 text-xs font-bold tracking-[0.15em] <%= ending_type_class %>">
          <%= ending_type_name %>
        </span>
      </div>

      <p class="whitespace-pre-wrap text-base leading-8 text-slate-200 sm:text-lg sm:leading-9">
        <%= @ending_scene.body %>
      </p>
    </section>

    <div class="mt-10 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
      <%= button_to "最初から遊び直す",
                    gamebook_play_sessions_path(@play_session.gamebook),
                    method: :post,
                    form_class: "sm:w-auto",
                    class: "w-full cursor-pointer rounded-xl border border-violet-400/50 bg-violet-600/80 px-6 py-3 font-bold text-white shadow-lg shadow-violet-950/30 transition duration-200 hover:-translate-y-0.5 hover:border-violet-300 hover:bg-violet-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-400 sm:w-auto" %>

      <%= link_to "ゲームブック一覧へ戻る",
                  gamebooks_path,
                  class: "inline-flex w-full items-center justify-center rounded-xl border border-slate-600 px-6 py-3 font-medium text-slate-300 transition duration-200 hover:border-slate-400 hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400 sm:w-auto" %>
    </div>
  </div>
</div>

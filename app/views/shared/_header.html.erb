<header class="sticky top-0 z-40 border-b border-[#29313e] bg-[#0d1119]/95 backdrop-blur">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
    <%# サービス名を押すとトップページへ移動する %>
    <%= link_to root_path,
                class: "group flex items-center gap-3",
                aria: { label: "トップページへ移動" } do %>
      <span class="flex size-9 items-center justify-center rounded-full border border-[#4b465d] bg-[#211f2c] font-serif text-lg text-[#9c91bc] transition group-hover:border-[#7770a3] group-hover:text-[#c7b98d]">
        ✦
      </span>

      <span class="font-serif text-lg font-bold tracking-wide text-[#e6e1d7] transition group-hover:text-[#c7b98d] sm:text-xl">
        AIソロTRPG型ゲームブック
      </span>
    <% end %>

    <%# メインメニュー %>
    <nav class="flex flex-wrap items-center justify-end gap-3" aria-label="メインメニュー">
      <% if logged_in? %>
        <%= link_to "ゲームブック一覧",
                    gamebooks_path,
                    class: "rounded-lg border border-[#414957] bg-[#121722] px-4 py-2 text-sm font-semibold text-[#c7cbd2] transition hover:border-[#7770a3] hover:bg-[#1a2030] hover:text-white" %>

        <span class="text-sm text-[#c7cbd2]">
          <%= current_user.name %>さん
        </span>

        <%= link_to "ログアウト",
                    logout_path,
                    data: { turbo_method: :delete },
                    class: "rounded-lg border border-[#414957] bg-[#121722] px-4 py-2 text-sm font-semibold text-[#c7cbd2] transition hover:border-[#7770a3] hover:bg-[#1a2030] hover:text-white" %>
      <% else %>
        <%= link_to "ユーザー登録",
                    new_user_path,
                    class: "rounded-lg border border-[#414957] bg-[#121722] px-4 py-2 text-sm font-semibold text-[#c7cbd2] transition hover:border-[#7770a3] hover:bg-[#1a2030] hover:text-white" %>

        <%= link_to "ログイン",
                    login_path,
                    class: "rounded-lg bg-[#7770a3] px-4 py-2 text-sm font-semibold text-white shadow-md shadow-black/20 transition hover:bg-[#8981b5]" %>
      <% end %>
    </nav>
  </div>
</header>

<% content_for :title, "ゲームブック一覧 | AIソロTRPG型ゲームブック" %>

<div class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
  <%# ページ見出し %>
  <header class="border-b border-[#29313e] pb-7">
    <p class="text-xs font-semibold tracking-[0.2em] text-[#9388b4]">
      MY GAMEBOOKS
    </p>

    <h1 class="mt-3 font-serif text-3xl font-bold tracking-tight text-[#e6e1d7] sm:text-4xl">
      ゲームブック一覧
    </h1>

    <p class="mt-4 max-w-2xl text-sm leading-7 text-[#9299a5] sm:text-base">
      あなたが作成した物語を確認できます。
    </p>

    <div class="mt-6">
      <%= link_to "新しく生成する",
                  new_gamebook_path,
                  class: "inline-flex items-center justify-center rounded-xl border border-[#6f648e] bg-[#5d5379] px-5 py-3 text-sm font-bold text-white transition hover:border-[#8377a4] hover:bg-[#6d628b]" %>
    </div>
  </header>

  <% if @gamebooks.any? %>
    <%# ゲームブック一覧 %>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <% @gamebooks.each do |gamebook| %>
        <% status_text, status_classes =
          case gamebook.generation_status
          when "completed"
            ["生成完了", "border-[#4d493c] bg-[#242219] text-[#c4b78f]"]
          when "failed"
            ["生成失敗", "border-[#694349] bg-[#2b1c20] text-[#d3979e]"]
          else
            ["生成中", "border-[#4b465d] bg-[#211f2c] text-[#b9afd0]"]
          end
        %>

        <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-[#343c4a] bg-[#151b25] shadow-xl shadow-black/20 transition hover:-translate-y-0.5 hover:border-[#4a5363]">
          <div class="flex flex-1 flex-col px-6 py-6">
            <%# 生成状態と作成日時 %>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= status_classes %>">
                <%= status_text %>
              </span>

              <time
                datetime="<%= gamebook.created_at.iso8601 %>"
                class="text-xs text-[#747c89]"
              >
                <%= l gamebook.created_at, format: :short %>
              </time>
            </div>

            <%# タイトルと概要 %>
            <h2 class="mt-5 font-serif text-xl font-bold leading-8 text-[#e6e1d7]">
              <%= gamebook.title.presence || "タイトル未設定" %>
            </h2>

            <p class="mt-3 flex-1 text-sm leading-7 text-[#9fa5af]">
              <%= gamebook.summary.presence || "ゲームブックの概要はまだ生成されていません。" %>
            </p>

            <%# ゲームブックの設定情報 %>
            <dl class="mt-6 grid grid-cols-3 border-y border-[#29313e] py-4">
              <div class="pr-3 text-center">
                <dt class="text-xs text-[#747c89]">
                  ジャンル
                </dt>
                <dd class="mt-2 text-sm font-semibold text-[#c7cbd2]">
                  <%= gamebook.genre %>
                </dd>
              </div>

              <div class="border-x border-[#29313e] px-3 text-center">
                <dt class="text-xs text-[#747c89]">
                  雰囲気
                </dt>
                <dd class="mt-2 text-sm font-semibold text-[#c7cbd2]">
                  <%= gamebook.tone %>
                </dd>
              </div>

              <div class="pl-3 text-center">
                <dt class="text-xs text-[#747c89]">
                  プレイ時間
                </dt>
                <dd class="mt-2 text-sm font-semibold text-[#c7b98d]">
                  約<%= gamebook.play_time %>分
                </dd>
              </div>
            </dl>

            <%# ゲームブック詳細画面へのリンク %>
            <div class="mt-6">
              <%= link_to "詳細を見る",
                          gamebook_path(gamebook),
                          class: "inline-flex w-full items-center justify-center rounded-xl border border-[#4a5363] bg-[#202735] px-5 py-3 text-sm font-bold text-[#e6e1d7] transition hover:border-[#606b7d] hover:bg-[#293241]" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <%# ゲームブックが存在しない場合 %>
    <div class="mt-8 rounded-2xl border border-dashed border-[#3b4350] bg-[#151b25] px-6 py-16 text-center">
      <div class="mx-auto flex size-14 items-center justify-center rounded-full border border-[#4b465d] bg-[#211f2c]">
        <span class="font-serif text-2xl text-[#9c91bc]" aria-hidden="true">
          ✦
        </span>
      </div>

      <h2 class="mt-5 font-serif text-xl font-bold text-[#e6e1d7]">
        まだゲームブックがありません
      </h2>

      <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-[#9299a5]">
        ゲームブックを作成すると、ここに物語が表示されます。
      </p>
    </div>
  <% end %>
</div>

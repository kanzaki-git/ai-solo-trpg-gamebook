<% content_for :title, "#{@gamebook.title.presence || 'ゲームブック詳細'} | AIソロTRPG型ゲームブック" %>

<div class="mx-auto max-w-4xl">
  <%# 一覧画面へ戻るリンク %>
  <%= link_to gamebooks_path,
              class: "inline-flex items-center gap-2 text-sm font-semibold text-[#9299a5] transition hover:text-[#e6e1d7]" do %>
    ゲームブック一覧へ戻る
  <% end %>

  <article class="mt-6 overflow-hidden rounded-2xl border border-[#343c4a] bg-[#151b25] shadow-xl shadow-black/20">
    <div class="px-5 py-7 sm:px-8 sm:py-9">
      <%# タイトルと概要 %>
      <h1 class="font-serif text-3xl font-bold leading-tight tracking-tight text-[#e6e1d7] sm:text-4xl">
        <%= @gamebook.title.presence || "タイトル未設定" %>
      </h1>

      <p class="mt-5 text-sm leading-7 text-[#9fa5af] sm:text-base">
        <%= @gamebook.summary.presence || "ゲームブックの概要はまだ生成されていません。" %>
      </p>

      <%# ゲームブックの設定情報 %>
      <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-[#29313e] bg-[#29313e] sm:grid-cols-2">
        <div class="bg-[#111720] px-5 py-4">
          <dt class="text-xs font-semibold text-[#747c89]">
            ジャンル
          </dt>
          <dd class="mt-2 text-sm text-[#c7cbd2]">
            <%= @gamebook.genre.presence || "未設定" %>
          </dd>
        </div>

        <div class="bg-[#111720] px-5 py-4">
          <dt class="text-xs font-semibold text-[#747c89]">
            世界観
          </dt>
          <dd class="mt-2 text-sm leading-6 text-[#c7cbd2]">
            <%= @gamebook.world_setting.presence || "未設定" %>
          </dd>
        </div>

        <div class="bg-[#111720] px-5 py-4">
          <dt class="text-xs font-semibold text-[#747c89]">
            雰囲気
          </dt>
          <dd class="mt-2 text-sm text-[#c7cbd2]">
            <%= @gamebook.tone.presence || "未設定" %>
          </dd>
        </div>

        <div class="bg-[#111720] px-5 py-4">
          <dt class="text-xs font-semibold text-[#747c89]">
            難易度
          </dt>
          <dd class="mt-2 text-sm text-[#c7cbd2]">
            <%= @gamebook.difficulty.presence || "未設定" %>
          </dd>
        </div>

        <div class="bg-[#111720] px-5 py-4 sm:col-span-2">
          <dt class="text-xs font-semibold text-[#747c89]">
            プレイ時間
          </dt>
          <dd class="mt-2 text-sm font-semibold text-[#c7b98d]">
            <% if @gamebook.play_time.present? %>
              約<%= @gamebook.play_time %>分
            <% else %>
              未設定
            <% end %>
          </dd>
        </div>
      </dl>

      <%# プレイ開始・再開ボタン %>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= button_to "最初から遊ぶ",
                      gamebook_play_sessions_path(@gamebook),
                      method: :post,
                      class: "inline-flex w-full items-center justify-center rounded-xl bg-[#c4b78f] px-5 py-3 text-sm font-bold text-[#17191e] transition hover:bg-[#d2c69e] sm:w-auto" %>

        <% if @playing_session %>
          <button
            type="button"
            class="inline-flex w-full items-center justify-center rounded-xl border border-[#4a5363] bg-[#202735] px-5 py-3 text-sm font-bold text-[#e6e1d7] transition hover:bg-[#293241] sm:w-auto"
          >
            続きから遊ぶ
          </button>
        <% end %>
      </div>

      <p class="mt-4 text-xs leading-6 text-[#747c89]">
        「最初から遊ぶ」を選択すると、新しいプレイを開始します。
      </p>
    </div>
  </article>
</div>
